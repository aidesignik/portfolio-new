generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CLIENT
  CARRIER
  ADMIN
}

enum CarrierStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum VehicleAmenity {
  AC
  WIFI
  USB
  TOILET
}

enum VehicleType {
  VAN
  MINIBUS
  MIDIBUS
  COACH
}

enum RideStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BlockReason {
  MAINTENANCE
  DAY_OFF
  VACATION
  OTHER
}

enum DocumentType {
  CONTRACT
  CONFIRMATION
  INVOICE
}

enum DocumentStatus {
  PENDING
  GENERATED
  FAILED
}

// ---------- Models ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         Role     @default(CLIENT)
  name         String?
  image        String?
  phone        String?
  locale       String   @default("sr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  carrier Carrier?
  rides   Ride[]   @relation("ClientRides")
}

model Carrier {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  companyName          String
  taxId                String   @unique
  registrationNumber   String?
  legalRepresentative  String?
  contactEmail         String
  contactPhone         String?
  city                 String
  address              String?
  description          String?
  licenseInfo          String?
  logoUrl              String?
  photos               String[] @default([])

  ratePerKm Decimal? @db.Decimal(10, 2)
  fixedFee  Decimal? @db.Decimal(10, 2)

  status    CarrierStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  vehicles Vehicle[]
  drivers  Driver[]
  rides    Ride[]
  blocks   Block[]
}

model Vehicle {
  id        String  @id @default(cuid())
  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  type         VehicleType
  model        String
  licensePlate String?
  year         Int
  seats        Int
  amenities    VehicleAmenity[] @default([])
  photos       String[]         @default([])
  status       VehicleStatus    @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  drivers DriverVehicle[]
  rides   Ride[]
  blocks  Block[]

  @@index([carrierId])
}

model Driver {
  id        String  @id @default(cuid())
  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  name        String
  phone       String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles DriverVehicle[]
  rides    Ride[]
  blocks   Block[]

  @@index([carrierId])
}

model DriverVehicle {
  driverId  String
  vehicleId String
  driver    Driver  @relation(fields: [driverId], references: [id])
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([driverId, vehicleId])
}

// A client's trip, from first submission through to completion. Starts
// unassigned (carrierId/vehicleId/driverId all null, status PENDING) and
// visible to every approved carrier; the first carrier to assign a vehicle
// and driver claims it (carrierId gets set then). Replaces what used to be
// three separate records (BookingRequest -> Offer -> Booking) — assigning
// a vehicle/driver is now a direct edit, not a priced offer needing accept.
model Ride {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation("ClientRides", fields: [clientId], references: [id])

  carrierId String?
  carrier   Carrier? @relation(fields: [carrierId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  pickupCity          String
  pickupLocation      String
  pickupLat           Float?
  pickupLng           Float?
  destinationCity     String
  destinationLocation String
  destinationLat      Float?
  destinationLng      Float?

  departureAt         DateTime
  isRoundTrip         Boolean   @default(false)
  returnAt            DateTime?
  passengerCount      Int
  // Computed server-side from geocoded pickup/stops/destination, or entered
  // directly by the carrier when they create+assign a ride themselves.
  estimatedDistanceKm Float?
  specialRequests     String?

  price    Decimal? @db.Decimal(10, 2)
  currency String   @default("RSD")

  status    RideStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  stops     RideStop[]
  documents Document[]

  @@index([clientId])
  @@index([carrierId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

model RideStop {
  id     String @id @default(cuid())
  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id])

  order    Int
  city     String
  location String
  lat      Float?
  lng      Float?

  @@index([rideId])
}

// Non-ride unavailability on a vehicle or driver (maintenance, day off,
// vacation) — exactly one of vehicleId/driverId is set, enforced in the API
// layer rather than the schema, matching this app's existing pattern of
// app-level validation over DB check constraints.
model Block {
  id        String  @id @default(cuid())
  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  startAt DateTime
  endAt   DateTime
  reason  BlockReason
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carrierId])
  @@index([vehicleId])
  @@index([driverId])
}

model Document {
  id     String @id @default(cuid())
  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id])

  type      DocumentType
  status    DocumentStatus @default(PENDING)
  number    String?
  fileUrl   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([rideId, type])
  @@index([rideId])
}
